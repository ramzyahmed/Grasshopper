<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48: .NET Framework build for Rhino 7 and Rhino 8 (.NET Framework runtime).
         net7.0-windows: .NET Core build for Rhino 8 (.NET Core runtime). -->
    <TargetFrameworks>net48;net7.0-windows</TargetFrameworks>
    <Version>1.0.0.0</Version>
    <Title>MyGrasshopperAssembly1</Title>
    <Description>Description of MyGrasshopperAssembly1</Description>
    <TargetExt>.gha</TargetExt>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Grasshopper" Version="7.18.22124.3001" IncludeAssets="compile;build" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net7.0-windows'">
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" IncludeAssets="compile;build" />
    <!-- Rhino 8 already ships System.Drawing.Common; compile against it only so a second copy is not deployed. -->
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="RhinoInside.Revit">
      <HintPath>..\..\..\..\Utils\API dlls\RhinoInside.Revit.dll</HintPath>
    </Reference>
  </ItemGroup>

  <PropertyGroup Condition="$(Configuration) == 'Debug' AND $([MSBuild]::IsOSPlatform(Windows))">
    <StartProgram>C:\Program Files\Rhino 7\System\Rhino.exe</StartProgram>
    <StartArguments></StartArguments>
    <StartAction>Program</StartAction>
  </PropertyGroup>

</Project>
